# Local-development defaults. Production must use exact image identities,
# HTTPS origins, explicit trust boundaries, and independently managed secrets.
# Backend settings. This SQLite URL is for direct local Python development and
# tests only. Docker integration and every production deployment use
# PostgreSQL. Never copy this default into a production secret.
DATABASE_URL=sqlite+aiosqlite:///./workchord.db
API_PREFIX=/api
DEPLOYMENT_ENVIRONMENT=development
# Set true only after the PostgreSQL rollout gate; production SQLite then fails closed.
DATABASE_POSTGRESQL_REQUIRED=false
# PostgreSQL example (percent-encode reserved characters in credentials):
# DATABASE_URL=postgresql+psycopg://workchord:secret@postgres:5432/workchord
# Compose uses this dedicated value so an old SQLite DATABASE_URL cannot
# silently switch the integration stack back to SQLite.
POSTGRES_DATABASE_URL=postgresql+psycopg://postgres:workchord-local-only@postgres:5432/workchord
POSTGRES_BACKUP_URL=postgresql://postgres:workchord-local-only@postgres:5432/workchord
POSTGRES_PASSWORD=workchord-local-only
# Optional host bindings for the base and self-hosted Compose profiles.
WORKCHORD_HTTP_BIND=127.0.0.1
WORKCHORD_HTTP_PORT=80
POSTGRES_HOST_PORT=5432
# Plaintext non-loopback binds are rejected by the self-hosted server script
# unless this explicit trusted-network override is enabled.
WORKCHORD_ALLOW_INSECURE_HTTP=false
# The self-hosted profile defaults this to true for a TLS-terminated server.
WORKCHORD_SESSION_COOKIE_SECURE=true
# Production/rehearsal Compose requires separate secret-manager values. These
# examples are comments so local development cannot accidentally use them.
# DATABASE_MIGRATION_URL=postgresql+psycopg://workchord_migrator:<percent-encoded-secret>@<writer-host>:5432/workchord
# DATABASE_RUNTIME_URL=postgresql+psycopg://workchord_runtime:<percent-encoded-secret>@<writer-host>:5432/workchord
# DATABASE_BACKUP_URL=postgresql://workchord_backup:<percent-encoded-secret>@<writer-host>:5432/workchord
# DATABASE_RESTORE_URL=postgresql://workchord_restore:<percent-encoded-secret>@<isolated-host>:5432/workchord_restore_example1
# DATABASE_EXTERNAL_BACKUP_REFERENCE=<approved-pitr-or-backup-identity>
# DATABASE_OWNER_ROLE=workchord_owner
DATABASE_PROCESS_ROLE=web
DATABASE_POOL_SIZE=15
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_PRE_PING=true
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_APPLICATION_NAME=workchord
# Optional SET ROLE target for the dedicated migration/repair login only.
# Runtime web and worker processes reject this setting.
DATABASE_SESSION_ROLE=
# Production PostgreSQL requires verify-full and an absolute mounted CA path.
DATABASE_SSL_MODE=prefer
DATABASE_SSL_ROOT_CERT=
# Optional client certificate authentication; configure both or neither.
DATABASE_SSL_CERT=
DATABASE_SSL_KEY=
DATABASE_READINESS_TIMEOUT_SECONDS=2
DATABASE_SLOW_QUERY_THRESHOLD_MS=500
# Production topology allocates at most 40 web and 20 worker connections across
# two replicas of each role. Per-process values below match that envelope.
# DATABASE_WEB_POOL_SIZE=15
# DATABASE_WEB_MAX_OVERFLOW=5
# DATABASE_WORKER_POOL_SIZE=8
# DATABASE_WORKER_MAX_OVERFLOW=2
# DATABASE_TLS_CERT_DIR=/absolute/read-only/database-tls
# DATABASE_BACKUP_DIR=/absolute/encrypted/backup-storage
# BACKUP_ENCRYPTION_CONFIRMED=true
# BACKUP_RETENTION_DAYS=35
# Explicit local-development opt-in; the backend default and Compose releases are false.
DEBUG=true
CORS_ORIGINS=["http://localhost:5173", "http://localhost"]

# LLM integration defaults (optional)
# Runtime values can be changed in Settings -> Runtime Config.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=3000

# Common language defaults
# Runtime values can be changed in Settings -> Runtime Config.
APP_UI_LANGUAGE=en
AI_LANGUAGE_MODE=auto

# GitHub integration defaults (optional)
# Runtime values can be changed in Settings -> Runtime Config.
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_REQUEST_TIMEOUT_SECONDS=10
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_CREATE_TRIAGE_FOR_UNMATCHED=false

# Controlled web intake defaults (optional)
# Runtime values can be changed in Settings -> Runtime Config.
WEB_INTAKE_TOKEN=
WEB_INTAKE_RATE_LIMIT_PER_MINUTE=30

# Email notification defaults (optional)
# Runtime values can be changed in Settings -> Notifications.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@workchord.local
SMTP_USE_TLS=true
NOTIFICATIONS_ENABLED=false

# Durable webhook/email delivery worker. Normal task mutations only enqueue.
OUTBOUND_DELIVERY_WORKER_ENABLED=false
OUTBOUND_DELIVERY_POLL_SECONDS=1
OUTBOUND_DELIVERY_BATCH_SIZE=50

# Frontend settings
VITE_API_URL=http://localhost:8001

# Secret encryption for runtime Settings UI.
# Required before saving API keys, tokens, webhook secrets, or SMTP passwords in the UI.
# Generate local WorkChord secrets with:
#   .venv/bin/python scripts/api_keys/generate_workchord_keys.py
SETTINGS_ENCRYPTION_KEY=

# Startup-only key for provisioning real agent actors through the agent API.
# MCP stdio clients should pass MCP_AGENT_API_KEY in their own process env.
AGENT_BOOTSTRAP_API_KEY=
# Optional operator-owned one-time agent credential sink. The directory must
# already exist with mode 0700; WorkChord creates one mode-0600 file per ref.
AGENT_TEAM_CREDENTIAL_SINK_DIR=
AGENT_TEAM_CREDENTIAL_SINK_REF=agent-team-secure-sink
AGENT_SKILL_BUNDLES_PUBLIC=false
# Required whenever public bundle delivery is enabled. Exact SHA-256 of the
# generated dist/agent-skills/checksums.json bytes.
AGENT_SKILL_BUNDLE_TRUSTED_CHECKSUMS_SHA256=
# Restart-bound model-aware routing rollout control. Keep off until the
# operator-owned topology readiness contract is satisfied.
MODEL_AWARE_ROUTING_MODE=off
MCP_DNS_REBINDING_PROTECTION=true
MCP_ALLOWED_HOSTS=["localhost","127.0.0.1"]
MCP_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8001"]
MCP_UNSAFE_ALLOW_PUBLIC_BINDING=false

# Startup-only key for runtime control-plane APIs such as system settings,
# scheduling rules, outbound webhooks, email settings, and agent supervision reads.
WORKCHORD_ADMIN_API_KEY=

# Optional egress/proxy security overrides. Keep private egress disabled unless
# a local development provider or webhook target explicitly requires it.
ALLOW_PRIVATE_EGRESS_URLS=false
TRUSTED_PROXY_IPS=[]

# Opaque browser attribution cookie. Secure must remain true behind production HTTPS;
# set false only for explicit local HTTP development.
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=2592000
SESSION_TOUCH_INTERVAL_SECONDS=300
AGENT_LAST_SEEN_INTERVAL_SECONDS=300

# Restart-bound write fence. All replicas and workers must receive the same
# mode/revision before an operator accepts writer-drain evidence.
MAINTENANCE_MODE=off
MAINTENANCE_REVISION=development
MAINTENANCE_REPLICA_ID=local
MAINTENANCE_RETRY_AFTER_SECONDS=60
MAINTENANCE_VALIDATION_ALLOWLIST=["/health","/health/live","/health/ready","/metrics"]
