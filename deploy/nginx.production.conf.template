log_format workchord_attempt escape=json
    '{"timestamp":"$time_iso8601","request_id":"$request_id",'
    '"method":"$request_method","path":"$uri","status":$status,'
    '"upstream_status":"$upstream_status","request_seconds":$request_time,'
    '"upstream_seconds":"$upstream_response_time","bytes":$body_bytes_sent}';

limit_req_zone $binary_remote_addr zone=workchord_api_rate:10m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=workchord_api_connections:10m;

resolver 127.0.0.11 valid=10s ipv6=off;

upstream workchord_frontend {
    server frontend:80;
}

upstream workchord_backend {
    zone workchord_backend 64k;
    server backend:8001 resolve;
    keepalive 32;
}

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${WORKCHORD_SERVER_NAME};
    return 308 https://${WORKCHORD_SERVER_NAME}$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate /etc/workchord/tls/fullchain.pem;
    ssl_certificate_key /etc/workchord/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    return 444;
}

server {
    listen 443 ssl;
    server_name ${WORKCHORD_SERVER_NAME};
    access_log /dev/stdout workchord_attempt;

    ssl_certificate /etc/workchord/tls/fullchain.pem;
    ssl_certificate_key /etc/workchord/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location = /health {
        proxy_pass http://workchord_backend;
        proxy_http_version 1.1;
        proxy_set_header Host ${WORKCHORD_SERVER_NAME};
        proxy_set_header X-Forwarded-Host ${WORKCHORD_SERVER_NAME};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Correlation-ID $request_id;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
    }

    location /api/ {
        limit_req zone=workchord_api_rate burst=60 nodelay;
        limit_conn workchord_api_connections 100;
        proxy_pass http://workchord_backend;
        proxy_http_version 1.1;
        proxy_set_header Host ${WORKCHORD_SERVER_NAME};
        proxy_set_header X-Forwarded-Host ${WORKCHORD_SERVER_NAME};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Correlation-ID $request_id;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
    }

    location / {
        proxy_pass http://workchord_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host ${WORKCHORD_SERVER_NAME};
        proxy_set_header X-Forwarded-Host ${WORKCHORD_SERVER_NAME};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
