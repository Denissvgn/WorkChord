{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workchord.local/schemas/postgresql-closeout-observations-v1.schema.json",
  "title": "WorkChord PostgreSQL closeout observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "audit_id",
    "audited_at",
    "auditor",
    "task_evidence",
    "release_gates",
    "stabilization",
    "post_cutover_verification",
    "backup_restore",
    "operational_audit",
    "availability",
    "sqlite_snapshot",
    "exceptions",
    "evidence_index_sha256",
    "no_omission_attestation"
  ],
  "properties": {
    "kind": {
      "const": "workchord-postgresql-closeout-observations"
    },
    "schema_version": {
      "const": 1
    },
    "audit_id": {
      "$ref": "#/$defs/identifier"
    },
    "audited_at": {
      "$ref": "#/$defs/timestamp"
    },
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "independent"],
      "properties": {
        "identity": {
          "$ref": "#/$defs/text"
        },
        "independent": {
          "const": true
        }
      }
    },
    "task_evidence": {
      "type": "object",
      "minProperties": 31,
      "maxProperties": 31,
      "propertyNames": {
        "enum": [
          "DBM-CON-001",
          "DBM-QA-001",
          "DBM-DEP-001",
          "DBM-CFG-001",
          "DBM-MIG-001",
          "DBM-MIG-002",
          "DBM-QA-002",
          "DBM-RUN-001",
          "DBM-RUN-002",
          "DBM-RUN-003",
          "DBM-PERF-001",
          "DBM-PERF-002",
          "DBM-WORK-001",
          "DBM-OBS-001",
          "DBM-MAINT-001",
          "DBM-DATA-001",
          "DBM-DATA-002",
          "DBM-DATA-003",
          "DBM-DEPLOY-001",
          "DBM-DEPLOY-002",
          "DBM-SEC-001",
          "DBM-BACKUP-001",
          "DBM-CUT-001",
          "DBM-QA-003",
          "DBM-SCALE-001",
          "DBM-RES-001",
          "DBM-DOC-001",
          "DBM-QUAL-001",
          "DBM-REHEARSE-001",
          "DBM-CUT-002",
          "DBM-DOC-002"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/task_entry"
      }
    },
    "release_gates": {
      "type": "object",
      "minProperties": 15,
      "maxProperties": 15,
      "propertyNames": {
        "enum": [
          "G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8",
          "G9", "G10", "G11", "G12", "G13", "G14", "G15"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/gate_entry"
      }
    },
    "stabilization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "started_at",
        "completed_at",
        "approved_duration_hours",
        "approval_evidence_sha256",
        "evidence_sha256"
      ],
      "properties": {
        "status": {
          "enum": ["not_started", "pending", "passed", "failed"]
        },
        "started_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "approved_duration_hours": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "approval_evidence_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        }
      }
    },
    "post_cutover_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "profile_id",
        "started_at",
        "completed_at",
        "result_sha256",
        "production_path",
        "all_applicable_slo_gates_passed",
        "unexplained_integrity_differences"
      ],
      "properties": {
        "status": {
          "enum": ["not_started", "passed", "failed"]
        },
        "profile_id": {
          "oneOf": [
            {"$ref": "#/$defs/identifier"},
            {"type": "null"}
          ]
        },
        "started_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "result_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "production_path": {
          "type": ["boolean", "null"]
        },
        "all_applicable_slo_gates_passed": {
          "type": ["boolean", "null"]
        },
        "unexplained_integrity_differences": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "backup_restore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "backup_completed_at",
        "restore_completed_at",
        "backup_sha256",
        "restore_report_sha256",
        "rpo_seconds",
        "rto_seconds",
        "schema_head",
        "isolated_target",
        "reconciled"
      ],
      "properties": {
        "status": {
          "enum": ["not_started", "passed", "failed"]
        },
        "backup_completed_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "restore_completed_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "backup_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "restore_report_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "rpo_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "rto_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "schema_head": {
          "type": ["string", "null"],
          "minLength": 3
        },
        "isolated_target": {
          "type": ["boolean", "null"]
        },
        "reconciled": {
          "type": ["boolean", "null"]
        }
      }
    },
    "operational_audit": {
      "type": "object",
      "minProperties": 7,
      "maxProperties": 7,
      "propertyNames": {
        "enum": [
          "application_logs",
          "unexpected_errors",
          "slow_queries",
          "lock_waits_and_deadlocks",
          "pool_pressure",
          "worker_queues",
          "domain_integrity"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/audit_entry"
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "observation_started_at",
        "observation_completed_at",
        "eligible_attempts",
        "successful_attempts",
        "objective_percent",
        "objective_claimed",
        "denominator_complete",
        "evidence_sha256"
      ],
      "properties": {
        "status": {
          "enum": ["not_started", "pending", "met", "missed"]
        },
        "observation_started_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "observation_completed_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "eligible_attempts": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "successful_attempts": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "objective_percent": {
          "const": 99.9
        },
        "objective_claimed": {
          "type": "boolean"
        },
        "denominator_complete": {
          "type": "boolean"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        }
      }
    },
    "sqlite_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "snapshot_sha256",
        "retention_approval_sha256",
        "retain_until",
        "disposed_at",
        "disposal_evidence_sha256",
        "writable"
      ],
      "properties": {
        "state": {
          "enum": ["not_created", "retained_read_only", "securely_disposed"]
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "retention_approval_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "retain_until": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "disposed_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "disposal_evidence_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "writable": {
          "type": ["boolean", "null"]
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "owner",
          "expires_at",
          "scope",
          "rationale",
          "approval_evidence_sha256"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "status": {
            "enum": ["approved_waiver", "open"]
          },
          "owner": {
            "$ref": "#/$defs/text"
          },
          "expires_at": {
            "$ref": "#/$defs/timestamp"
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(DBM-[A-Z]+-[0-9]{3}|G(?:[1-9]|1[0-5]))$"
            }
          },
          "rationale": {
            "$ref": "#/$defs/text"
          },
          "approval_evidence_sha256": {
            "$ref": "#/$defs/nullable_sha256"
          }
        }
      }
    },
    "evidence_index_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "no_omission_attestation": {
      "const": "Every database-migration task, release gate, exception, and required post-cutover observation known to the auditor is listed; no failed, missing, expired, or unfavorable evidence is omitted."
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+\\-]{2,255}$"
    },
    "text": {
      "type": "string",
      "minLength": 3
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nullable_timestamp": {
      "oneOf": [
        {"$ref": "#/$defs/timestamp"},
        {"type": "null"}
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "task_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_sha256", "exception_id"],
      "properties": {
        "status": {
          "enum": ["complete", "waived", "incomplete"]
        },
        "evidence_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "exception_id": {
          "oneOf": [
            {"$ref": "#/$defs/identifier"},
            {"type": "null"}
          ]
        }
      }
    },
    "gate_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_sha256", "exception_id"],
      "properties": {
        "status": {
          "enum": ["passed", "waived", "failed", "pending"]
        },
        "evidence_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "exception_id": {
          "oneOf": [
            {"$ref": "#/$defs/identifier"},
            {"type": "null"}
          ]
        }
      }
    },
    "audit_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_sha256"],
      "properties": {
        "status": {
          "enum": ["not_started", "passed", "failed"]
        },
        "evidence_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        }
      }
    }
  }
}
