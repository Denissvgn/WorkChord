{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workchord.local/contracts/postgresql-load-result-v1.schema.json",
  "title": "WorkChord PostgreSQL load result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "run_id",
    "created_at",
    "qualification_candidate",
    "status",
    "capacity_contract",
    "toolchain",
    "target",
    "release",
    "seed",
    "traffic",
    "operations",
    "classifications",
    "workload_evidence",
    "snapshots",
    "external_metrics",
    "integrity",
    "gates",
    "errors",
    "document_sha256"
  ],
  "properties": {
    "kind": {"const": "workchord-postgresql-load-result"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "qualification_candidate": {"type": "boolean"},
    "status": {"enum": ["passed", "failed", "incomplete", "dry_run"]},
    "capacity_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {"const": "workchord-postgresql-capacity-v1"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "http", "mcp", "python"],
      "properties": {
        "runner": {"const": "workchord-load-v1"},
        "http": {"$ref": "#/$defs/tool"},
        "mcp": {"$ref": "#/$defs/tool"},
        "python": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "authorized_host", "environment"],
      "properties": {
        "base_url": {"type": "string", "format": "uri"},
        "authorized_host": {"type": "string", "minLength": 1},
        "environment": {"enum": ["test", "rehearsal", "production"]},
        "change_id": {"type": ["string", "null"]}
      }
    },
    "release": {"type": "object"},
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "qualification_eligible"],
      "properties": {
        "manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "qualification_eligible": {"type": "boolean"}
      }
    },
    "traffic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "phase",
        "target_duration_seconds",
        "actual_duration_seconds",
        "target_rps",
        "actual_rps",
        "target_virtual_users",
        "active_clients_peak",
        "open_connections_peak",
        "in_flight_requests_peak",
        "scheduled_attempts",
        "completed_attempts",
        "eligible_attempts",
        "operation_counts",
        "status_counts"
      ],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "phase": {"enum": ["dry", "small", "warmup", "steady", "burst", "soak", "external_wait"]},
        "target_duration_seconds": {"type": "number", "minimum": 0},
        "actual_duration_seconds": {"type": "number", "minimum": 0},
        "target_rps": {"type": "number", "minimum": 0},
        "actual_rps": {"type": "number", "minimum": 0},
        "target_virtual_users": {"type": "integer", "minimum": 0},
        "active_clients_peak": {"type": "integer", "minimum": 0},
        "open_connections_peak": {"type": "integer", "minimum": 0},
        "in_flight_requests_peak": {"type": "integer", "minimum": 0},
        "scheduled_attempts": {"type": "integer", "minimum": 0},
        "completed_attempts": {"type": "integer", "minimum": 0},
        "eligible_attempts": {"type": "integer", "minimum": 0},
        "operation_counts": {"$ref": "#/$defs/counts"},
        "status_counts": {"$ref": "#/$defs/counts"}
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/measurement"}
    },
    "classifications": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/measurement"}
    },
    "workload_evidence": {"type": "object"},
    "snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readiness_before", "readiness_after", "metrics_before", "metrics_after"],
      "properties": {
        "readiness_before": {"type": ["object", "null"]},
        "readiness_after": {"type": ["object", "null"]},
        "metrics_before": {"type": ["string", "null"]},
        "metrics_after": {"type": ["string", "null"]}
      }
    },
    "external_metrics": {"type": "object"},
    "integrity": {"type": "object"},
    "gates": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/gate"}
    },
    "errors": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "kind", "message"],
        "properties": {
          "operation_id": {"type": "string"},
          "kind": {"type": "string"},
          "message": {"type": "string", "maxLength": 500}
        }
      }
    },
    "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50", "p95", "p99", "max"],
      "properties": {
        "p50": {"type": "number", "minimum": 0},
        "p95": {"type": "number", "minimum": 0},
        "p99": {"type": "number", "minimum": 0},
        "max": {"type": "number", "minimum": 0}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "statuses", "latency_ms"],
      "properties": {
        "attempts": {"type": "integer", "minimum": 0},
        "statuses": {"$ref": "#/$defs/counts"},
        "latency_ms": {"$ref": "#/$defs/latency"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "actual", "required", "reason"],
      "properties": {
        "status": {"enum": ["passed", "failed", "missing", "not_applicable"]},
        "actual": {},
        "required": {},
        "reason": {"type": "string"}
      }
    }
  }
}
